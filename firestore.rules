rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields:
    //   - uid: string (required) - Firebase Auth UID
    //   - email: string (required) - User email
    //   - displayName: string - User display name
    //   - role: string (required, enum: ['student', 'teacher']) - User role
    //   - createdAt: timestamp - Creation time
    //
    // Collection: courses
    // Fields:
    //   - name: string (required)
    //   - description: string
    //   - teacherId: string (required) - UID of the teacher
    //   - createdAt: timestamp
    //
    // Collection: exams
    // Fields:
    //   - title: string (required)
    //   - description: string
    //   - courseId: string (required)
    //   - teacherId: string (required)
    //   - questions: list (required) - List of question objects
    //   - durationMinutes: number
    //   - createdAt: timestamp
    //
    // Collection: results
    // Fields:
    //   - examId: string (required)
    //   - studentId: string (required)
    //   - score: number (required)
    //   - totalQuestions: number (required)
    //   - answers: list - Student's answers
    //   - completedAt: timestamp
    //
    // Collection: notifications
    // Fields:
    //   - title: string (required)
    //   - content: string (required)
    //   - teacherId: string (required)
    //   - createdAt: timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return isAuthenticated() && getUserData().role == 'teacher';
    }

    function isStudent() {
      return isAuthenticated() && getUserData().role == 'student';
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['student', 'teacher'] &&
             data.uid == request.auth.uid;
    }

    function isValidCourse(data) {
      return data.keys().hasAll(['name', 'teacherId']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.teacherId == request.auth.uid;
    }

    function isValidExam(data) {
      return data.keys().hasAll(['title', 'courseId', 'teacherId', 'questions']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.teacherId == request.auth.uid &&
             data.questions is list && data.questions.size() > 0;
    }

    function isValidResult(data) {
      return data.keys().hasAll(['examId', 'studentId', 'score', 'totalQuestions']) &&
             data.examId is string &&
             data.studentId == request.auth.uid &&
             data.score is number &&
             data.totalQuestions is number;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['title', 'content', 'teacherId']) &&
             data.title is string && data.title.size() > 0 &&
             data.content is string && data.content.size() > 0 &&
             data.teacherId == request.auth.uid;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && 
                    request.resource.data.role == resource.data.role;
    }

    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher() && isValidCourse(request.resource.data);
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid && isValidCourse(request.resource.data);
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher() && isValidExam(request.resource.data);
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid && isValidExam(request.resource.data);
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }

    match /results/{resultId} {
      // Students can see their own results. Teachers can see all results for their exams.
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || 
        isTeacher()
      );
      allow create: if isStudent() && isValidResult(request.resource.data);
      allow update: if false; // Results are immutable
      allow delete: if isTeacher(); // Only teachers can clear results if needed
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isTeacher() && isValidNotification(request.resource.data);
      allow update: if isTeacher() && resource.data.teacherId == request.auth.uid && isValidNotification(request.resource.data);
      allow delete: if isTeacher() && resource.data.teacherId == request.auth.uid;
    }
  }
}
